# Canonical URL used in metadata, robots.txt and sitemap.xml.
# Leave empty in local development to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Turso (libSQL) database used for short share links.
# Create a database with `turso db create codecanvas`, then copy its URL and
# an auth token. Without these values the app still works, but the share
# dialog falls back to long links.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development without a Turso account: use a SQLite file instead.
# The table is created automatically on the first request.
# TURSO_DATABASE_URL=file:.data/codecanvas.db
