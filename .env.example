# Canonical URL used for metadata, robots.txt and sitemap.xml.
# Leave empty in local development to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Blob store used for short share links. Vercel injects this automatically when
# a Blob store is connected to the project. Locally, run `vercel dev` so the
# blob client can exchange Vercel OIDC credentials. Without it, the share dialog
# falls back to long links.
# BLOB_STORE_ID=
